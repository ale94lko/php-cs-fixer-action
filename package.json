{
  "name": "php-cs-fixer-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action to check PHP coding standards with php-cs-fixer",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses && node scripts/normalize-dist.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci-local": "node dist/index.js",
    "dev-check": "bash scripts/dev-check.sh",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale94lko/php-cs-fixer-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^4.1.0",
    "@actions/core": "^1.11.1",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "//": "Pins and overrides: see docs/dependency-notes.md (ncc CJS / webpackMissingModule).",
  "overrides": {
    "typescript": "~5.9.3",
    "undici": "^6.28.0",
    "uuid": "^11.1.1"
  }
}
