# Skip php-cs-fixer runtime PHP version check (needed on PHP 8.3+).
PHP_CS_FIXER_IGNORE_ENV=1

# Release tag of php-cs-fixer.phar to download (or reuse when already vendored).
PHP_CS_FIXER_VERSION=v3.95.21

# Pre-verified phar baked into the Docker image (outside the /app volume mount).
PHP_CS_FIXER_PHAR=/opt/php-cs-fixer/php-cs-fixer

# Config used by docker compose / scripts/ci-local.sh. Local path skips php-cs-fixer-rules.
CONFIG_FILE=tests/fixtures/.php-cs-fixer.dist.php
CONFIG_PATH=tests/fixtures/.php-cs-fixer.dist.php
