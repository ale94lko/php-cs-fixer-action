# Optional absolute path to a pre-verified php-cs-fixer binary/phar for offline local runs.
# Leave empty to download (checksum-verified) or restore from the Actions cache in CI.
PHP_CS_FIXER_PHAR=

# Release tag of php-cs-fixer.phar to download (or reuse when already cached).
PHP_CS_FIXER_VERSION=v3.95.26

# Config used by scripts/ci-local.sh. Local path skips php-cs-fixer-rules.
CONFIG_FILE=tests/fixtures/.php-cs-fixer.dist.php
CONFIG_PATH=tests/fixtures/.php-cs-fixer.dist.php

# Optional php-cs-fixer-rules ref / full-rules flag (Action inputs; local fixture config ignores them).
RULES_VERSION=v1.0.1
USE_FULL_RULES=true

# Optional Action input env fallbacks for local runs (scripts/ci-local.sh).
PHP_CS_FIXER_MODE=check
PHP_CS_FIXER_PATHS=
PHP_CS_FIXER_ALLOW_RISKY=yes
PHP_CS_FIXER_PHP_BIN=
PHP_CS_FIXER_WORKING_DIRECTORY=
PHP_CS_FIXER_USING_CACHE=
PHP_CS_FIXER_CACHE_FILE=
PHP_CS_FIXER_ONLY_CHANGED=false
PHP_CS_FIXER_BASE_REF=

# Do NOT set PHP_CS_FIXER_IGNORE_ENV — it is deprecated and removed in php-cs-fixer 4.0.
# Prefer Config::setUnsupportedPhpVersionAllowed(true) or --allow-unsupported-php-version=yes.

# Optional. When set, Action failures POST JSON { "step", "code", "message" } to this HTTPS URL
# (redirects are rejected). Leave unset in CI; the Action never requires it.
ERROR_TRACKING_URL=

# GitHub Actions job-summary path (set by the runner). Leave empty locally.
GITHUB_STEP_SUMMARY=

# Optional. Relative workspace path for a SARIF 2.1.0 report (Action input sarif-file).
PHP_CS_FIXER_SARIF_FILE=

# Pull-request base branch for only-changed diffs. Normally set by the GitHub Actions runner.
GITHUB_BASE_REF=main

# Temp root for phar / report / downloaded config. Normally set by the GitHub Actions runner.
RUNNER_TEMP=/tmp

# Actions tool-cache root for the php-cs-fixer phar. Leave empty locally (falls back to a temp dir).
RUNNER_TOOL_CACHE=

# Internal to scripts/bump-php-cs-fixer.sh when rewriting the default tag. Leave empty.
NEW_TAG=
OLD_TAG=
