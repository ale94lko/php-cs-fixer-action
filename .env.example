# Skip php-cs-fixer runtime PHP version check (needed on PHP 8.3+).
PHP_CS_FIXER_IGNORE_ENV=1

# Release tag of php-cs-fixer.phar to download (or reuse when already cached).
PHP_CS_FIXER_VERSION=v3.95.21

# Optional. Absolute path to a pre-verified php-cs-fixer binary/phar for offline local runs.
# Leave empty to download (checksum-verified) or restore from the Actions cache in CI.
PHP_CS_FIXER_PHAR=

# Config used by scripts/ci-local.sh. Local path skips php-cs-fixer-rules.
CONFIG_FILE=tests/fixtures/.php-cs-fixer.dist.php
CONFIG_PATH=tests/fixtures/.php-cs-fixer.dist.php

# Optional. Pass --allow-risky=yes|no (default yes, matching prior Action behavior).
PHP_CS_FIXER_ALLOW_RISKY=yes

# Optional. When set, Action failures POST JSON { "step", "code", "message" } to this http(s) URL.
# Leave unset in CI; the Action never requires it.
ERROR_TRACKING_URL=

# GitHub Actions job-summary path (set by the runner). Leave empty locally.
GITHUB_STEP_SUMMARY=

# Actions tool-cache root for the php-cs-fixer phar. Leave empty locally (falls back to a temp dir).
RUNNER_TOOL_CACHE=

# Internal to scripts/bump-php-cs-fixer.sh when rewriting the default tag. Leave empty.
NEW_TAG=
OLD_TAG=
